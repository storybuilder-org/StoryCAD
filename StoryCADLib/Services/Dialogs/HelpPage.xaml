<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="StoryCADLib.Services.Dialogs.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="StoryCAD can be daunting, so here are some resources to help you get started:" Margin="0,10" />

                <HyperlinkButton Content="StoryCAD Concepts (Video)" NavigateUri="https://youtu.be/eBJtGZCBasE"
                                 AutomationProperties.AutomationId="HelpConceptsVideoButton" />
                <HyperlinkButton Content="A 5-minute Introduction to StoryCAD (Video)"
                                 NavigateUri="https://youtu.be/oBOXeBVRNRE"
                                 AutomationProperties.AutomationId="HelpIntroVideoButton" />
                <HyperlinkButton Content="Meet Collaborator (Video)" NavigateUri="https://youtu.be/-2j-Bgflv7A"
                                 AutomationProperties.AutomationId="HelpCollaboratorVideoButton" />
                <HyperlinkButton Content="All StoryCAD videos (YouTube)" NavigateUri="https://www.youtube.com/@StoryCAD"
                                 AutomationProperties.AutomationId="HelpVideosChannelButton" />
                <HyperlinkButton Content="Frequently Asked Questions" NavigateUri="https://www.storybuilder.org/faq"
                                 AutomationProperties.AutomationId="HelpFaqButton" />
                <HyperlinkButton Content="Tutorial"
                                 NavigateUri="{x:Bind ViewModel.TutorialUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="HelpTutorialButton" />
                <HyperlinkButton Content="User manual"
                                 NavigateUri="{x:Bind ViewModel.ManualUri, Mode=OneTime}"
                                 AutomationProperties.AutomationId="HelpUserManualButton" />
                <HyperlinkButton Content="Events" NavigateUri="https://storybuilder.org/events/"
                                 AutomationProperties.AutomationId="HelpEventsButton" />
            </StackPanel>
        </ScrollViewer>

        <CheckBox Grid.Row="1" Content="Don't show this again" Click="Clicked"
                  HorizontalAlignment="Center" Margin="0,10,0,0"
                  AutomationProperties.AutomationId="HelpDontShowAgainCheck" />
    </Grid>
</Page>
