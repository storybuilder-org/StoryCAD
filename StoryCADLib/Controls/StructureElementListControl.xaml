<UserControl
    x:Class="StoryCADLib.Controls.StructureElementListControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tools="using:StoryCADLib.ViewModels.Tools">

    <!-- All Scenes or all Problems of the outline, with how the structure uses each one (issue #1546). -->
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Elements" VerticalAlignment="Center" Margin="0,0,8,0" />
            <RadioButtons ItemsSource="{x:Bind ViewModel.ElementSource, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedElementSource, Mode=TwoWay}"
                          MaxColumns="2"
                          VerticalAlignment="Center"
                          AutomationProperties.AutomationId="StructureElementsRadios"
                          AutomationProperties.Name="Elements" />
        </StackPanel>

        <!-- Dynamic Elements List (Scenes or Problems based on RadioButtons) -->
        <ListView x:Name="ElementsList" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.CurrentElementSource, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedListElement, Mode=TwoWay}"
                  SelectionMode="Single"
                  CanDragItems="True"
                  DragItemsStarting="ElementsList_DragItemsStarting"
                  DragItemsCompleted="ElementsList_DragItemsCompleted"
                  AllowDrop="True"
                  DragOver="ElementsList_DragOver"
                  Drop="ElementsList_Drop"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  AutomationProperties.AutomationId="ElementsList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <!-- Names wrap so a long scene name is not cut off at the 1036 x 744 window.
                 The use of the element is text, so the mark does not depend on color. -->
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="tools:StructureElementItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4"
                          AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                        <TextBlock Grid.Column="0" Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{x:Bind UseText, Mode=OneWay}"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
