<UserControl
    x:Class="StoryCADLib.Controls.BeatColumnControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:StoryCADLib.Controls"
    xmlns:models="using:StoryCADLib.Models"
    xmlns:tools="using:StoryCADLib.ViewModels.Tools">

    <!-- One Problem: a header, its beats, and its elements on no beat (issue #1546).
         The Structure tab uses it with no header. The beat tree window uses one for each Problem. -->
    <UserControl.Resources>
        <local:VisibilityHolder x:Key="DescriptionVisibility" Value="Collapsed" />
    </UserControl.Resources>

    <Grid x:Name="ColumnRoot" RowSpacing="6"
          AutomationProperties.Name="{x:Bind ViewModel.ProblemName, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="56" />
        </Grid.RowDefinitions>

        <!-- Header: the Problem and its beat sheet -->
        <StackPanel x:Name="HeaderPanel" Grid.Row="0" Spacing="2">
            <TextBlock Text="{x:Bind ViewModel.ProblemName, Mode=OneWay}"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.ProblemCategory, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
            <ComboBox ItemsSource="{x:Bind ViewModel.PlotPatternNames, Mode=OneWay}"
                      PlaceholderText="{x:Bind ViewModel.StructureModelTitle, Mode=OneWay}"
                      SelectedValue="{x:Bind ViewModel.StructureModelTitle, Mode=TwoWay}"
                      Text="{x:Bind ViewModel.StructureModelTitle, Mode=OneWay}"
                      HorizontalAlignment="Stretch"
                      AutomationProperties.AutomationId="BeatColumnSheetCombo"
                      AutomationProperties.Name="Beat Sheet" />
        </StackPanel>

        <!-- Beats. Each beat is a card. -->
        <ListView x:Name="BeatsListView" Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.StructureBeats, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedBeat, Mode=TwoWay}"
                  SelectedIndex="{x:Bind ViewModel.SelectedBeatIndex, Mode=TwoWay}"
                  SelectionMode="Single"
                  CanDragItems="True"
                  DragItemsStarting="BeatsListView_DragItemsStarting"
                  DragItemsCompleted="ListView_DragItemsCompleted"
                  GotFocus="List_GotFocus"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="BeatsList">
            <!-- A container for every beat, also out of view: the beat tree draws a connector to a card. -->
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="Padding" Value="8,4,8,4" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="tools:StructureBeat">
                    <!-- Accessible name must bind inline here: WinUI 3 silently ignores bindings in Style Setters (Setter.Value docs; unoplatform/uno#4826). -->
                    <Grid ColumnDefinitions="Auto,*"
                          VerticalAlignment="Center"
                          Margin="8,8,8,8"
                          RowDefinitions="Auto,Auto,Auto"
                          Background="Transparent"
                          AllowDrop="True"
                          DragOver="Target_DragOver"
                          Drop="Card_Drop"
                          AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                        <!-- Icon spans the rows -->
                        <SymbolIcon Grid.Column="0"
                                    Grid.RowSpan="3"
                                    Symbol="{x:Bind ElementIcon, Mode=OneWay}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center" />

                        <!-- Beat Title on top row -->
                        <TextBlock Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{x:Bind Title, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />

                        <!-- Beat description, when the switch is on -->
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{x:Bind Description, Mode=OneWay}"
                                   Visibility="{Binding Value, Source={StaticResource DescriptionVisibility}}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,4" />

                        <!-- Element Name on bottom row -->
                        <TextBlock Grid.Column="1"
                                   Grid.Row="2"
                                   Text="{x:Bind ElementName, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="13" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- The elements that belong to the Problem and are on no beat -->
        <TextBlock Grid.Row="2" Text="On no beat"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" />
        <ListView x:Name="NoBeatListView" Grid.Row="3"
                  ItemsSource="{x:Bind ViewModel.ElementsOnNoBeat, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedNoBeatElement, Mode=TwoWay}"
                  SelectionMode="Single"
                  CanDragItems="True"
                  DragItemsStarting="NoBeatListView_DragItemsStarting"
                  DragItemsCompleted="ListView_DragItemsCompleted"
                  AllowDrop="True"
                  DragOver="Target_DragOver"
                  Drop="NoBeatListView_Drop"
                  GotFocus="List_GotFocus"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  HorizontalAlignment="Stretch"
                  AutomationProperties.AutomationId="NoBeatElementsList"
                  AutomationProperties.Name="On no beat">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StoryElement">
                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap"
                               Margin="0,4"
                               AutomationProperties.Name="{x:Bind Name, Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
