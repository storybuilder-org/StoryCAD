    <!-- UI-automation driver for the StoryCADAutomation runner (issue #1421). Dev/CI-only:
         referenced solely by StoryCADAutomation, never shipped to users. MIT-licensed; upstream
         moves slowly (4.0.0 published 2022-09-24, 5.0.0 2025-02-25 per nuget.org), so bump
         deliberately alongside a smoke-script re-run, not in bulk package updates. Pinned 2026-07-13. -->
    <PackageVersion Include="FlaUI.Core" Version="5.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.1.0" />
